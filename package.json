{
  "name": "cicd-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "npm run test:backend && vitest run",
    "test:backend": "node --import tsx --test test/app.test.ts",
    "test:frontend": "vitest run",
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "concurrently": "^9.2.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
